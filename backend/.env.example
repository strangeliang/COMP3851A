PORT=8000
GOOGLE_CLIENT_ID=
HOST=127.0.0.1
# Render detects its one-hop public ingress automatically. Direct servers default to 0.
# Other deployments: set only the actual trusted hop count or proxy IP/subnet.
# TRUST_PROXY=0
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Default mail provider: Resend. Use an approved sender for public recipients.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
# To use SMTP, set MAIL_PROVIDER=smtp and fill these values privately.
# SMTP_PORT supports 465 (TLS) or 587 (required STARTTLS).
# MAIL_FROM must meet the provider's mailbox or verified-domain requirements.
# See docs/SMTP_SETUP.md. No credentials are included in this example.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Required in production: BOTH absolute paths must point to the persistent volume.
# Production FRONTEND_URL / PUBLIC_APP_URL must be the exact public HTTPS origin.
# STUDY_DATABASE_PATH=/app/data/study_companion.db
# Local-only demo fixtures. Never set this to 1 on a public deployment.
# STUDY_SEED_DEMO=1
# In development only, originals default to a directory beside the database.
# STUDY_UPLOAD_PATH=/app/data/originals
# Keep this key on the backend. Never put it in a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
