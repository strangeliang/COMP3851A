PORT=8000
GOOGLE_CLIENT_ID=
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Email links via Resend. Use a verified sender domain for public recipients.
RESEND_API_KEY=
MAIL_FROM=
# Required in production: BOTH absolute paths must point to the persistent volume.
# Production FRONTEND_URL / PUBLIC_APP_URL must be the exact public HTTPS origin.
# STUDY_DATABASE_PATH=/app/data/study_companion.db
# Local-only demo fixtures. Never set this to 1 on a public deployment.
# STUDY_SEED_DEMO=1
# In development only, the default is originals beside the database.
# STUDY_UPLOAD_PATH=D:/COMP3851A/backend/data/originals
# Keep this key on the backend. Never put it in a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
